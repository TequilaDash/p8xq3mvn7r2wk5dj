        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to find signing certificate. Please check JIT-Less Diagnose page and see if there are any issues with your JIT-Less setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法找到证书用于签名。请查看“免JIT诊断”页面以检查免JIT模式设置存在问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法找到用於簽章的證書。請查看「免JIT診斷」頁面以檢查免JIT模式設定的問題。"
          }
