{
  "sourceLanguage": "en",
  "strings": {
    "lc.appBanner.addToHomeScreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Home Screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到主屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加至主畫面"
          }
        }
      }
    },
    "lc.appBanner.confirmRunWhenMultitasking": {
      "comment": "lc.appBanner.confirmRunWhenMultitasking",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps are running in multitask mode. Running this app will terminate those apps. Continue?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一些App正在以多任务模式运行，启动此App会终止这些App，要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚有應用程式在多任務模式執行。執行此App將停止那些應用程式。要繼續嗎？"
          }
        }
      }
    },
    "lc.appBanner.confirmUninstallMsg %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to uninstall %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要卸载%@吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝%@？"
          }
        }
      }
    },
    "lc.appBanner.confirmUninstallTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
