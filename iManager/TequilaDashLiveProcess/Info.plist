<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  TequilaDash 访客进程宿主扩展 (LiveContainer LiveProcess 等价物) 的 Info.plist.
	  方案: C:/Users/xcrad/.omp/work/reports/m5-extension-target-plan.md 第 3 节.
	  内容结构照 LC 的 LiveProcess/Info.plist, 值按本仓口径改写 (scheme 名 / 类名 / 文案).
	  与 Tunnel 的 Info.plist 同风格: 手写完整键值, 不走 GENERATE_INFOPLIST_FILE.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TequilaDash LiveProcess</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tequila.dash.liveprocess.extensionurlscheme</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- 必须 [0] 且第一项: LCBootstrap 等价代码读 [0][0] 判定 isLiveProcess
				     (LCBootstrap.m:670-672). 用带前缀的名字, 不与真实 LC 的 "liveprocess" 撞. -->
				<string>TequilaDashliveprocess</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>DirectionalGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>MicroGamepad</string>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 访客 App 的 ATS 策略由宿主 plist 决定, 收紧会让大量访客的明文请求失败 -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<!-- 照主 App Resources/Info.plist 同一份 69 项清单 (访客的网络发现走宿主声明) -->
		<string>_altserver._tcp</string>
		<string>_remotepairing-pairable-host._tcp</string>
		<string>_remotepairing-manual-pairing._tcp</string>
		<string>_services._dns-sd._udp</string>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
		<string>_sftp-ssh._tcp</string>
		<string>_sleep-proxy._udp</string>
		<string>_ssh._tcp</string>
		<string>_apple-mobdev2._tcp</string>
		<string>_asquic._udp</string>
		<string>_companion-link._tcp</string>
		<string>_meshcop._udp</string>
		<string>_remotepairing._tcp</string>
		<string>_rp-tunnel._tcp</string>
		<string>_srpl-tls._tcp</string>
		<string>_trel._udp</string>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
		<string>_smb._tcp</string>
		<string>_afpovertcp._tcp</string>
		<string>_printer._tcp</string>
		<string>_ipp._tcp</string>
		<string>_ipps._tcp</string>
		<string>_scanner._tcp</string>
		<string>_daap._tcp</string>
		<string>_dpap._tcp</string>
		<string>_airport._tcp</string>
		<string>_homekit._tcp</string>
		<string>_hap._tcp</string>
		<string>_touch-able._tcp</string>
		<string>_spotify-connect._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_device-info._tcp</string>
		<string>_workstation._tcp</string>
		<string>_rfb._tcp</string>
		<string>_net-assistant._udp</string>
		<string>_rdlink._tcp</string>
		<string>_stikpairprobe._tcp</string>
		<string>_webdav._tcp</string>
		<string>_webdavs._tcp</string>
		<string>_ftp._tcp</string>
		<string>_telnet._tcp</string>
		<string>_coap._udp</string>
		<string>_coaps._udp</string>
		<string>_mqtt._tcp</string>
		<string>_adb._tcp</string>
		<string>_airdrop._tcp</string>
		<string>_sidecar._tcp</string>
		<string>_sonos._tcp</string>
		<string>_plex._tcp</string>
		<string>_amzn-alexa._tcp</string>
		<string>_home-assistant._tcp</string>
		<string>_rtsp._tcp</string>
		<string>_sip._udp</string>
		<string>_sip._tcp</string>
		<string>_h323._tcp</string>
		<string>_h323._udp</string>
		<string>_ws._tcp</string>
		<string>_wss._tcp</string>
		<string>_remoted._tcp</string>
		<string>_coredevice._tcp</string>
		<string>_appletv-v2._tcp</string>
		<string>_apple-mobdev._tcp</string>
		<string>_jitstreamer._tcp</string>
		<string>_matter._tcp</string>
		<string>_matterc._udp</string>
		<string>_airprint._tcp</string>
		<string>_vnc._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>访客应用请求访问日历, 用于读写访客自己的日程数据.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>访客应用请求写入日历, 用于添加访客自己的日程.</string>
	<key>NSCameraUsageDescription</key>
	<string>访客应用请求使用相机, 用于拍摄照片与视频.</string>
	<key>NSContactsUsageDescription</key>
	<string>访客应用请求访问通讯录, 用于读写访客自己的联系人.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>访客应用请求获取位置, 用于访客自身的定位功能.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>访客应用请求使用麦克风, 用于录音与语音输入.</string>
	<key>NSMotionUsageDescription</key>
	<string>访客应用请求访问运动与健身数据, 用于计步等运动功能.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>访客应用请求向照片图库添加内容, 用于保存图片与视频.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>访客应用请求访问照片图库, 用于读取访客选择的照片.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>访客应用请求访问提醒事项, 用于读写访客自己的提醒.</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- 永不被系统自动拉起, 只能由宿主 beginExtensionRequestWithInputItems: 显式请求
			     (LC 同款: LiveProcess/Info.plist:95-99; 若改 TRUEPREDICATE 会出现在系统分享候选里) -->
			<key>NSExtensionActivationRule</key>
			<string>FALSEPREDICATE</string>
		</dict>
		<!-- LC 选的系统扩展点, 让系统把 .appex 当「应用型 UI 宿主」承载 (iOS 18.x 需实测) -->
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.ar.viewer</string>
		<!-- ObjC 类名直接写 (本仓无 PRODUCT_MODULE_NAME. 前缀习惯), 类在 main.m 定义 -->
		<key>NSExtensionPrincipalClass</key>
		<string>TequilaDashLiveProcessHandler</string>
		<key>NSExtensionContextClass</key>
		<string>NSExtensionContext</string>
		<key>NSExtensionContextHostClass</key>
		<string>NSExtensionContext</string>
	</dict>
	<key>SBAppUsesLocalNotifications</key>
	<integer>1</integer>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- 访客 App 自己会请求这些后台能力, 而 plist 是宿主进程的, 访客的声明无处生效
		     (LC 同款 8 项: LiveProcess/Info.plist:120-130) -->
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>external-accessory</string>
		<string>fetch</string>
		<string>location</string>
		<string>nearby-interaction</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>XPCService</key>
	<dict>
		<!-- 应用型 XPC 服务 + 多实例: 多访客进程并存的基础 (私有键, LC 同款需实测) -->
		<key>ServiceType</key>
		<string>Application</string>
		<key>_MultipleInstances</key>
		<true/>
		<key>_ProcessType</key>
		<string>App</string>
	</dict>
</dict>
</plist>
