<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 上游 entitlements.xml:5-21 同款口径 (owner 2026-11-11 要求「完全对齐上游」).
	     缺 application-identifier / com.apple.developer.team-identifier 时，
	     LCJITLessDiagnoseView:148-153 拿不到 teamId 与 correctBundleId，
	     「团队名」「包名」两行显示灰色、免 JIT 判定必红。 -->
	<key>application-identifier</key>
	<string>$(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array>
		<string>health-records</string>
	</array>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.wifi.manager-access</key>
	<true/>
	<key>com.apple.wifi.join-any</key>
	<true/>
	<!-- ShareExtension / LaunchAppExtension 与本 App 共享容器、证书、URL scheme.
	     值照抄上游 xcconfigs/Global.xcconfig:14-15:
	       APP_GROUP_SIDESTORE = group.com.SideStore.SideStore$(DEVELOPMENT_TEAM_SUFFIX)
	       APP_GROUP_ALTSTORE  = group.com.rileytestut.AltStore$(DEVELOPMENT_TEAM_SUFFIX)
	     Release 时 DEVELOPMENT_TEAM_SUFFIX 为空 → 就是 SideStore/AltStore 的固定 group，
	     因为侧载工具（SideStore/AltStore）会给应用注入这两个 group。
	     自签/免费账号没有这两个 group → 侧载会报 entitlement 不匹配，此时须把这两项删掉
	     （主 App 其余功能不受影响，只是分享面板扩展不可用）。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<!-- 本仓自有 group: 侧载工具（SideStore/AltStore）按 `group.<bundleId>.<TEAMID>` 生成并注入.
		     截图实测: 本机可用的是 `group.com.tequila.dash.U82B5LN29B`.
		     用 $(DEVELOPMENT_TEAM) 让签名时替换成 TEAMID，拼出与侧载工具一致的值. -->
		<string>group.com.tequila.dash.$(DEVELOPMENT_TEAM)</string>
		<!-- 上游 entitlements.xml:17-19 同款两项 (owner 2026-11-11 要求「完全对齐上游」).
		     上游用 xcconfig 变量 $(APP_GROUP_SIDESTORE)/$(APP_GROUP_ALTSTORE);
		     本仓无 xcconfig，直接展开成它们指向的固定值
		     (vendor/LiveContainer/xcconfigs/Global.xcconfig:14-15).
		     侧载工具会给应用注入这两个 group；自签/免费账号没有时会报 entitlement 不匹配，
		     届时删掉这两行即可（本仓自有 group 不受影响）. -->
		<string>group.com.SideStore.SideStore</string>
		<string>group.com.rileytestut.AltStore</string>
	</array>
	<!-- 访客 App 的 keychain 隔离组（上游 entitlements.xml 同款，128 个）.
	     LC 的 Tweaks/SecItem.m:120-127 把访客的 SecItem 调用 hook 到
	     `<TEAMID>.com.kdt.livecontainer.shared[.N]`；每个容器随机分配一个 N（0..<128），
	     实现访客之间、访客与主 App 之间的 keychain 隔离。
	     没有这些组 → 访客读写 keychain 会撞主 App 或彼此。
	     $(DEVELOPMENT_TEAM). 由签名时替换成你的 TEAMID（含尾部点）。

	     ⚠️ 这里**不能用** `$(AppIdentifierPrefix)`：本仓出的是未签名 IPA，
	     由侧载工具（SideStore/isideload/ESign）在安装时施加 entitlements。
	     实测（owner 2026-11-11 真机截图）：侧载工具会展开 `$(DEVELOPMENT_TEAM)`
	     （所以「包名」「团队名」两行显示正确），但**不展开** `$(AppIdentifierPrefix)`
	     —— 产物里留字面量 → LCJITLessDiagnoseView:134-145 拿
	     `"<TEAMID>.com.kdt.livecontainer.shared"` 去比，永远不匹配
	     → 「keychain-access-groups 正确」恒为「否」→ 免 JIT 前置检查过不去。
	     上游能用 `$(AppIdentifierPrefix)` 是因为它走 Xcode 正常签名（变量在签名期展开）。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).com.kdt.livecontainer.shared</string>
		<string>$(DEVELOPMENT_TEAM).com.kdt.livecontainer.shared.1</string>
		<string>$(DEVELOPMENT_TEAM).com.kdt.livecontainer.shared.2</string>
		<string>$(DEVELOPMENT_TEAM).com.kdt.livecontainer.shared.3</string>
